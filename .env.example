# Zero-Idle AI Sentry (.env.example)
# Copy to .env and customize for your local network. Never commit real credentials or PII.

# 2.5W Edge Camera (Wyze Cam Pan v1 / Dafang-Hacks)
DOORBELL_CAM_IP="192.168.1.50"
DOORBELL_CAM_USER="admin"
DOORBELL_CAM_PASS="your_camera_password"

# Sleeping GPU Server Target for Wake-on-LAN
SENTRY_TARGET_MAC="00:11:22:33:44:55"
SENTRY_SERVER_IP="192.168.1.100"
SENTRY_SERVER_PORT="8099"

# Local Ollama Multimodal Vision (Gemma 4 E2B)
OLLAMA_GENERATE_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_VISION_MODEL="gemma4:e2b-it-q4_K_M"

# Notification Channels (Discord + Optional Carrier Email-to-SMS/MMS Gateway)
DISCORD_BOT_TOKEN="your_discord_bot_token"
DOORBELL_DISCORD_CHANNELS="123456789012345678"
DOORBELL_SMS_TO="5551234567@vtext.com"
DOORBELL_MMS_TO="5551234567@vzwpix.com"
